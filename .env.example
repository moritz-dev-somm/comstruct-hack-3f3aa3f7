# Browser-visible (auto-provisioned by Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only (required by the supplier email agent)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AgentMail — required to send supplier purchase-request emails
# Get from https://agentmail.to
AGENTMAIL_API_KEY=

# Lovable AI Gateway (auto-provisioned in Lovable Cloud)
LOVABLE_API_KEY=

# Optional: override the public URL used for AgentMail webhook registration
# Defaults to the hardcoded Lovable production URL in agent/agent.server.ts
PUBLIC_APP_URL=
