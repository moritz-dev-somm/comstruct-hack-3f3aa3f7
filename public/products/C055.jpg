setConfirmationEmailCta1\":\"Kontaktieren Sie uns -\",\"passwordResetConfirmationEmailCta2\":\"Anmelden www.torkglobal.com/de/de/sign-in\",\"registrationEmailFooterCopyright\":\"© 2025 Essity Hygiene und Health AB\",\"registrationEmailFooterWebsiteLink\":\"torkglobal.com/de/de www.torkglobal.com/de/de\",\"registrationEmailFooterPrivacyPolicy\":\" Datenschutzerklärung https://www.torkglobal.com/de/de/rechtliche-hinweise/datenschutzerklaerung\"},\"passwordResetEmail\":{\"passwordResetEmailSubject\":\"Passwort zurücksetzen\",\"passwordResetEmailHeadline\":\"Ihr Link zum Zurücksetzen des Passworts\",\"passwordResetEmailBodyText1\":\"Wir haben eine Anfrage auf Zurücksetzung des Passworts für Ihr Tork Global Konto erhalten. Bitte nutzen Sie den Link unten, um jetzt ein neues Passwort zu erstellen.\",\"passwordResetEmailCta\":\"Passwort zurücksetzen {tridionDCXPasswordResetLink}\",\"passwordResetEmailBodyText2\":\"Das waren nicht Sie? Kein Problem, dann ignorieren Sie bitte diese E-Mail. Es werden garantiert keine Änderungen vorgenommen.\",\"passwordResetEmailContact\":\"Sie benötigen weitere Hilfe? Kontaktieren Sie uns -\",\"registrationEmailFooterCopyright\":\"© 2025 Essity Hygiene und Health AB\",\"registrationEmailFooterWebsiteLink\":\"torkglobal.com/de/de www.torkglobal.com/de/de\",\"registrationEmailFooterPrivacyPolicy\":\"Datenschutzerklärung https://www.torkglobal.com/de/de/rechtliche-hinweise/datenschutzerklaerung\"},\"rejectionOfApprovalEmail\":{\"rejectionOfApprovalEmailSubject\":\"Konto nicht freigegeben\",\"rejectionOfApprovalEmailHeadline\":\"Ihre Anfrage für ein Tork Global-Konto\",\"rejectionOfApprovalEmailBodyText1\":\"Hallo, wir haben Ihre Anfrage für ein Tork Global-Konto überprüft, können Ihnen jedoch derzeit keinen Zugang gewähren.\",\"rejectionOfApprovalEmailBodyText2\":\"Ein Tork Global-Konto ist für unsere Handelspartner vorgesehen. Wenn das auf Sie zutrifft, wenden Sie sich bitte an unser Kundenserviceteam.\",\"rejectionOfApprovalEmailBodyText3\":\"Wir benötigen einige klärende zusätzliche Informationen, um Ihre Kontoanfrage erneut zu bewerten.\",\"rejectionOfApprovalEmailCta\":\"Kontaktieren Sie uns -\",\"registrationEmailFooterCopyright\":\"© 2025 Essity Hygiene und Health AB\",\"registrationEmailFooterWebsiteLink\":\"torkglobal.com/de/de www.torkglobal.com/de/de\",\"registrationEmailFooterPrivacyPolicy\":\"Datenschutzerklärung https://www.torkglobal.com/de/de/rechtliche-hinweise/datenschutzerklaerung\"},\"verificationEmail\":{\"verificationEmailSubject\":\"E-Mail-Bestätigung\",\"verificationEmailHeadline\":\"Bestätigung Ihrer E-Mail-Adresse\",\"verificationEmailBodyText1\":\"Um zu bestätigen, dass wirklich Sie es sind, und um mit der Einrichtung Ihres Tork Global-Kontos fortzufahren, bestätigen Sie bitte Ihre E-Mail-Adresse durch Klicken auf den Link unten.\",\"verificationEmailBodyText2\":\"Bitte beachten Sie: Sie können sich erst anmelden, wenn Sie eine Willkommens-E-Mail von Tork Global erhalten haben, die einen Link zum Aktivieren Ihres Kontos enthält. Diese wird nach Abschluss des Verifizierungsprozesses versendet.\",\"verificationEmailContact\":\"Sie benötigen weitere Hilfe? Kontaktieren Sie uns -\",\"verificationEmailCta\":\"E-Mail-Adresse bestätigen {tridionDCXVerificationLink}\",\"registrationEmailFooterCopyright\":\"© 2025 Essity Hygiene und Health AB\",\"registrationEmailFooterWebsiteLink\":\"torkglobal.com/de/de www.torkglobal.com/de/de\",\"registrationEmailFooterPrivacyPolicy\":\"Datenschutzerklärung https://www.torkglobal.com/de/de/rechtliche-hinweise/datenschutzerklaerung\"},\"welcomeEmail\":{\"welcomeEmailSubject\":\"Willkommen!\",\"welcomeEmailHeadline\":\"Willkommen bei Tork Global\",\"welcomeEmailBodyText1\":\"Vielen Dank für das Erstellen eines Tork Global-Kontos – Sie sind startklar!\",\"welcomeEmailBodyText2\":\"Tork Global bietet Ihnen Self-Service-Tools, ob Sie in unserem Webshop einkaufen, Verkaufsmaterialien zusammenstellen oder unser Sortiment kennenlernen möchten.\",\"welcomeEmailBodyText3\":\"Schauen Sie regelmäßig vorbei – Ihr Konto bekommt bald viele weitere Funktionen.\",\"welcomeEmailCta\":\"Anmelden www.torkglobal.com/de/de/sign-in\",\"welcomeEmailContact\":\"Wenn Sie Hilfe beim Start benötigen, kontaktieren Sie uns gerne -\",\"registrationEmailFooterCopyright\":\"© 2025 Essity Hygiene und Health AB\",\"registrationEmailFooterWebsiteLink\":\"torkglobal.com/de/de www.torkglobal.com/de/de\",\"registrationEmailFooterPrivacyPolicy\":\"Datenschutzerklärung https://www.torkglobal.com/de/de/rechtliche-hinweise/datenschutzerklaerung\"},\"orderSimulation\":{\"contactCustomerService\":\"Für Informationen zur Verfügbarkeit oder Empfehlungen zu einer geeigneten Alternative wenden Sie sich bitte an unser Kundenserviceteam unter (+49) 621 778 4700.\",\"goToCart\":\"Zum Warenkorb\",\"productsRemoved\":\"Das/die folgende(n) Produkt(e) ist/sind derzeit nicht verfügbar und wurde(n) daher entfernt:      \",\"close\":\"Schließen\",\"notAvailableWithProduct\":\"Leider ist {productName} derzeit nicht bestellbar.      \",\"notAvailableAddToCart\":\"Leider ist dieses Produkt derzeit nicht verfügbar und kann nicht in Ihren Warenkorb gelegt werden.      \",\"productsAdded\":\"Sie haben {count} Produkt(e) Ihrem Warenkorb hinzugefügt      \",\"allProductsRemoved\":\"Es tut uns leid, alle Produkte wurden aus Ihrem Warenkorb entfernt, da sie derzeit nicht verfügbar sind.      \",\"goToCartInfo\":\"Gehen Sie zu Ihrem Warenkorb, um Ihre Bestellung zu bearbeiten oder abzuschließen. Für Informationen zur Verfügbarkeit oder Beratung zu einem alternativen Produkt wenden Sie sich bitte an unser Kundenservice-Team unter (+49) 621 778 4700.      \"},\"contracts\":{\"contractsTitle\":\"Verträge\",\"contractsCount\":\"Verträge\",\"contractHeaderSubtitle\":\"Finden Sie ganz einfach Ihre Endkunden-Verträge und sehen Sie alle zugehörigen Produkte und Preise.\",\"searchPlaceHolder\":\"Vertragsdetails\",\"noResultFound\":\"Keine Ergebnisse gefunden\",\"searchError\":\"Etwas ist 