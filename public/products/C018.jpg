  <script>
    function userlikeTrackingEvent(event_name, global_ctx, session_ctx) {
      const event = new CustomEvent("userlikeTrackingEvent", {
        detail: { event_name, global_ctx, session_ctx },
      });

      // Dispatch the event on the Angular component's host element
      const myComponentElement = document.querySelector("app-root");
      if (myComponentElement) {
        myComponentElement.dispatchEvent(event);
      }
    }
  </script>
