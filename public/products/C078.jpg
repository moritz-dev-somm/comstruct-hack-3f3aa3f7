html[lang^="en"] .product-detail-page .image-text-overlay .text:empty {
  display: none;
}

/* Produktseiten: Bild + weißen Platzhalter im image-text-overlay vollständig entfernen */
.product-detail-page .image-text-overlay {
  display: block !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}

.product-detail-page .image-text-overlay .image {
  display: none !important;
  height: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* Produktseiten: Bild + alle leeren weißen Platzhalter im image-text-overlay entfernen */
.product-detail-page .image-text-overlay {
  display: block !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* Bild-Spalte komplett entfernen */
.product-detail-page .image-text-overlay .image {
  display: none !important;
  height: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* Leeren Text-Block entfernen (h2 + p sind leer, aber Element existiert) */
.product-detail-page
.image-text-overlay
.textbox
.text:not(:has(.headline:not(:empty), p:not(:empty))) {
  display: none !important;
}

/* Nachrückender Text ohne seitlichen Versatz */
.product-detail-page .image-text-overlay .textbox {
  margin-left: 0 !important;
}

/* EN only: "Caramba entdecken" Button auf Produktseiten ausblenden */
html[lang^="en"] .product-detail-page .image-text-overlay .textbox > a.btn.btn-primary-dark {
  display: none !important;
}

/* Wrapper darf Bild nicht beschneiden */
.woocommerce div.product div.images,
.woocommerce-product-gallery__wrapper,
.woocommerce-product-gallery__image,
.flex-viewport {
  height: auto !important;
  overflow: visible !important;
}

/* Container darf nicht beschneiden */
.product-header .cols,
.product-header .container,
.product-header .image {
  overflow: visible !important;
}

.product-header .cols {
  align-items: center !important;
}

/* Bild natürlich skalieren, Breite nutzen, keine Verzerrung */
.product-header img {
  display: block;
  max-width: 100% !important;
  width: 100% !important;        /* nutzt die verfügbare Breite */
  height: auto !important;
  max-height: 650px;             /* kannst du anpassen */
  object-fit: contain !important; /* kein Abschneiden */
}

/* Weiße Fläche kommt vom Wrapper: Hintergrund auf dunkel/transparent setzen */
.woocommerce-product-gallery__wrapper,
.woocommerce-product-gallery__image,
.flex-viewport,
.woocommerce div.product div.images {
  background: transparent !important; /* oder z.B. #1f1f1f */
}

/* falls ein einzelnes Element den weißen Kasten macht */
.product-header .image,
.product-header .gallery,
.product-header figure {
  background: transparent !important;
}

/* Quadrat-Zwang entfernen */
.product-detail-page .content .product-header .gallery .big-image #main {
  aspect-ratio: auto !important;
  height: auto !important;
}

/* Falls .big-image selbst quadratisch ist */
.product-detail-page .content .product-header .gallery .big-image {
  aspect-ratio: auto !important;
  height: auto !important;
  background: transparent !important;
}

/* Hintergrund von Wrappern sicher entfernen */
.product-detail-page .content .product-header .gallery,
.product-detail-page .content .product-header .gallery .big-image {
  background: transparent !important;
}
